# ── MirzaKateb server config ──────────────────────────────
# Copy to ".env" and fill in. NEVER commit the real .env.

# Port the server listens on
PORT=3000

# Sign JWT session cookies with a long random string (change this!)
JWT_SECRET=change-me-to-a-long-random-string

# Set to "production" behind HTTPS (enables Secure cookies)
NODE_ENV=production

# ── AI (OpenAI-compatible) ─────────────────────────────────
# Required for transcription + summaries/actions/chat.
OPENAI_API_KEY=sk-...
# Optional: any OpenAI-compatible gateway (AvalAI / OpenRouter / Groq / local)
# OPENAI_BASE_URL=https://api.avalai.ir/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ── Admin panel login ──────────────────────────────────────
# Defaults to admin / admin1245@ if omitted.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin1245@

# Where the SQLite db + uploaded audio live (default: ./data)
# DATA_DIR=/var/lib/mirzakateb
