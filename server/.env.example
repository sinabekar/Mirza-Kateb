# ── MirzaKateb server config ──────────────────────────────
# Copy to ".env" and fill in. NEVER commit the real .env.

# Port the server listens on
PORT=3000

# Sign JWT session cookies with a long random string (change this!)
JWT_SECRET=change-me-to-a-long-random-string

# Enable ONLY when serving over HTTPS — it makes the login cookie "Secure",
# which a plain-HTTP (or bare-IP) site cannot use, breaking login.
# Leave commented while testing on http://<ip>. Uncomment once you add HTTPS.
# NODE_ENV=production

# ── Text AI (OpenAI-compatible) ───────────────────────────
# Required for summaries, action items, chat, and (if no GEMINI_API_KEY) transcription.
OPENAI_API_KEY=sk-...
# Optional: any OpenAI-compatible gateway (AvalAI / OpenRouter / Groq / local)
# OPENAI_BASE_URL=https://api.avalai.ir/v1
OPENAI_MODEL=gpt-4o
# Transcription model.
# - Whisper models (via /audio/transcriptions): whisper-1, groq.whisper-large-v3
# - Gemini multimodal models (via chat/completions, works through AvalAI from Iran):
#   gemini-3.5-flash, gemini-3.8-flash, gemini-2.5-flash  ← recommended for Persian
OPENAI_TRANSCRIBE_MODEL=gemini-3.5-flash

# ── Google Gemini direct API (only works outside Iran) ──────────────
# Only needed if NOT using AvalAI Gemini above.
# GEMINI_API_KEY=AIza...
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# ── Admin panel login ──────────────────────────────────────
# Defaults to admin / admin1245@ if omitted.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin1245@

# Where the SQLite db + uploaded audio live (default: ./data)
# DATA_DIR=/var/lib/mirzakateb
